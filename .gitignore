.gradle/
/.kotlin/
build/
*/build/

local.properties

.cxx/
.externalNativeBuild/

*.apk
*.aab
*.ap_
*.dex

.idea/workspace.xml
.idea/tasks.xml
.idea/caches/
.idea/libraries/

# Local on-device model binaries
# Keep model files on the local machine or distribute them through release assets / Git LFS.
app/src/main/assets/models/*.tflite
app/src/main/assets/models/*.task
app/src/main/assets/models/*.onnx
app/src/main/assets/models/*.ort
app/src/main/assets/models/*.bin
app/src/main/assets/models/*.gguf
!app/src/main/assets/models/README.md

.DS_Store
Thumbs.db

# Python bytecode / caches (host reference tooling must not commit compiled artifacts)
__pycache__/
*.py[cod]

# Generated N4 host reference tensors (large, reproducible) — regenerate on demand.
# Keep manifests/identity/SHA records; do not commit hundreds of MB of .f32le/.npy.
artifacts/exynos-n4-*/reference/full/
artifacts/exynos-n4-*/reference/tiled/

# N5 file-backed RGB8 artifacts and staging files (large, intermediate)
artifacts/exynos-n5-*/output/
*.rgb8
*.tmp

# Stable DEBUG signing — private keystore must never be committed (public SHA-256 may be tracked separately)
*.jks
*.keystore
.projectnuke/
app/debug.keystore
app/*.jks
signing.properties
local.signing.properties
debug-signing.properties

# Local debug/test artifacts
# Only root-level text files are ignored so docs and tool requirements stay trackable.
/*.txt
*.log
*.tmp
/logs/
/test-output/
/captures/
/scratch/
*.bundle
*.hprof
java_pid*.hprof*
hs_err_pid*.log
replay_pid*.log
